<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Design.master.cs" Inherits="Design" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title></title>
    <asp:ContentPlaceHolder id="head" runat="server">
    </asp:ContentPlaceHolder>

    <!-- Basic need -->

<meta charset="UTF-8">
<meta name="description" content="">
<meta name="keywords" content="">
<meta name="author" content="">
<link rel="profile" href="#">

<!--Google Font-->
<link rel="stylesheet" href='http://fonts.googleapis.com/css?family=Dosis:400,700,500|Nunito:300,400,600' />
<!-- Mobile specific meta -->
<meta name=viewport content="width=device-width, initial-scale=1">
<meta name="format-detection" content="telephone-no">

<!-- CSS files -->
<link rel="stylesheet" href="css/plugins.css">
<link rel="stylesheet" href="css/style.css">



</head>
<body>
    <form id="form1" runat="server" >
    <div id="preloader">
        <img class="logo" src="images/logo1.png" alt="" width="119" height="58">
        <div id="status">
            <span></span>
            <span></span>
        </div>
    </div>

    <!-- BEGIN | Header -->
    <header class="ht-header">
        <div class="container">
            <nav class="navbar navbar-default navbar-custom">
                <!-- Brand and toggle get grouped for better mobile display -->
                <div class="navbar-header logo">
                    <div class="navbar-toggle" data-toggle="collapse" data-target="#bs-example-navbar-collapse-1">
                        <span class="sr-only">Toggle navigation</span>
                        <div id="nav-icon1">
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>
                    </div>
                    <a href="Home.aspx"><img class="logo" src="images/logo1.png" alt="" width="119" height="58"></a>
                </div>
                <!-- Collect the nav links, forms, and other content for toggling -->
             




                <div class="collapse navbar-collapse flex-parent" id="bs-example-navbar-collapse-1">
                    <ul class="nav navbar-nav flex-child-menu menu-left">
                      
                        <li><a href="Home.aspx">Search Films</a></li>
                        <li><a href="Celebs.aspx">Celebs</a></li>
                        <li><a href="FindUsers.aspx">Find Friends</a></li>
                        <li><a href="Events.aspx">Events</a></li>
                        <li><a href="News.aspx">News</a></li>
                        <li><a href="ClientArea.aspx">My Profile</a></li>
                        <li id="liAdminArea" runat="server" visible="false"><a href="AdminArea.aspx">Admin Area</a></li>
                       
                    </ul>
                    <ul class="nav navbar-nav flex-child-menu menu-right">
                        <li id="liLoggedOut" runat="server">
                            <a href="Login.aspx">Login</a>
                        </li>
                        <li id="liSignUp" class="btn" runat="server">
                            <a href="Regi.aspx">Signup</a>
                        </li>
                        <li id="liLoggedIn" runat="server" visible="false">
                            <span style="color: white; padding: 10px 15px; display: inline-block;">
                                Hello, <asp:Label ID="lblUsername" runat="server" style="font-weight: bold;"></asp:Label>
                            </span>
                        </li>
                        <li id="liLogout" runat="server" visible="false" class="btn">
                            <asp:LinkButton ID="btnLogout" runat="server" OnClick="btnLogout_Click" style="color: white; padding: 10px 15px; display: inline-block; text-decoration: none; cursor: pointer;">Log Out</asp:LinkButton>
                        </li>
                    </ul>
</div>
<!-- /.navbar-collapse -->
</nav>

</div>
</header>
<!-- END | Header -->

<div class="movie-items">
<div class="flex-center" style="margin-top:40px;" >
        <asp:ContentPlaceHolder id="ContentPlaceHolder1" runat="server">
        </asp:ContentPlaceHolder>
    </div>
</div>
</form>
<script src="js/jquery.js"></script>
<script src="js/plugins.js"></script>
<script src="js/plugins2.js"></script>
<script src="js/custom.js"></script>
</body>
</html>